# OtakuVerse — modelo de ambiente. Copie para .env e preencha o que precisar.
# Nada daqui é obrigatório para o site funcionar (exceto DATABASE_URL).

# --- Banco (obrigatório) ---
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Agendador (recomendado) ---
# Chave usada por /api/cron/tick e /api/cron/refresh. Gere com: openssl rand -hex 24
CRON_KEY=

# --- Domínio público (após registrar, ex.: https://otakuverse.app) ---
# Alimenta sitemap, canonical e metadata do Next.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics gratuito (opcional, ativa ao preencher) ---
# GA4: "G-..." obtido em analytics.google.com (Admin → Fluxos de dados)
NEXT_PUBLIC_GA_ID=
# Cloudflare Web Analytics: token do beacon em dash.cloudflare.com → Web Analytics
# (privacy-first, sem cookies — não exige banner LGPD)
NEXT_PUBLIC_CF_BEACON=

# --- Google AdSense (opcional, safe-only) ---
# Publisher ID "ca-pub-XXXXXXXXXXXXXXXX" após aprovação da conta.
# O AdSlot SÓ exibe anúncio em páginas classification=safe com modo adulto desligado.
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Amazon Associates por país (opcional) ---
# Cada programa é independente: cadastre-se no país e cole o tracker dele aqui.
# Ex.: BR "seulojao-20" (formato do Associados BR), US "yourstore-20", etc.
NEXT_PUBLIC_AMAZON_TAG_BR=
NEXT_PUBLIC_AMAZON_TAG_US=
NEXT_PUBLIC_AMAZON_TAG_CA=
NEXT_PUBLIC_AMAZON_TAG_UK=
NEXT_PUBLIC_AMAZON_TAG_ES=
NEXT_PUBLIC_AMAZON_TAG_MX=
NEXT_PUBLIC_AMAZON_TAG_FR=
NEXT_PUBLIC_AMAZON_TAG_DE=
NEXT_PUBLIC_AMAZON_TAG_IT=
NEXT_PUBLIC_AMAZON_TAG_JP=

# --- Produção: Vercel + Turso (v3.8) ---
# O MESMO código roda local (file:) e na Vercel (libsql://) — só muda a env.
# Turso: https://app.turso.tech → database → Connect → copie URL + token
# DATABASE_URL=libsql://otakuverse-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# Endereço público canônico (sitemap, og:url, canonical):
# NEXT_PUBLIC_SITE_URL=https://otakuverse.vercel.app
# Aoi fora da plataforma Z.ai — qualquer endpoint OpenAI-compatible:
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_API_KEY=sua-chave
# AI_MODEL=glm-4.5-flash
# Segredo do Vercel Cron (mesmo valor de CRON_KEY serve; o Bearer é injetado pela Vercel):
# CRON_SECRET=
