generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Work {
  id             String   @id // id numérico puro da AniList (ex.: "16498") | md-<uuid> do MangaDex | kt-<id> do Kitsu
  malId          Int?
  type           String // manga | manhwa | manhua | lightnovel | anime
  format         String?
  title          String
  titleEn        String?
  titleNative    String?
  synonyms       String? // JSON string[]
  synopsis       String?
  synopsisPT     String? // tradução PT-BR gerada por IA (cache)
  cover          String // URL principal da capa (fonte A)
  coverAlt       String? // URL alternativa (fonte B) — fallback anti-bloqueio
  coverColor     String?
  banner         String?
  status         String? // RELEASING | FINISHED | HIATUS | NOT_YET_RELEASED | CANCELLED
  chapters       Int?
  volumes        Int?
  episodes       Int?
  duration       Int?
  startDate      String?
  endDate        String?
  country        String? // JP | KR | CN | TW | TH | ES
  isAdult        Boolean  @default(false)
  classification String   @default("safe") // safe | suggestive | adult
  adultTags      String? // JSON string[] — Hentai | Doujin | +18 | Adulto
  genres         String // JSON string[]
  tags           String // JSON [{ name, rank }]
  avgScore       Int?
  popularity     Int?
  favourites     Int?
  authors        String? // JSON [{ name, role }]
  extLinks       String? // JSON [{ site, url, language, type, color, icon }]
  magazine       String? // JSON { name, publisher, demographic, schedule, accepts, famous, source }
  network        String? // dramas: emissora/plataforma
  source         String?
  siteUrl        String?
  lastUpdate     Int? // unix seconds — última atualização na fonte
  nextEpisodeAt  String? // anime: data real do próximo episódio (ISO)
  nextEpisodeNum Int?
  coverAlts      String? // JSON string[] — capas alternativas reais (multi-fonte)
  langs          String? // JSON string[] — idiomas de tradução disponíveis (MangaDex)
  ptTags         String? // JSON string[] — tags/gêneros traduzidos PT-BR (via tagmap)
  trending       Int? // posição atual em tendência (1 = topo)
  trendingAt     Int? // unix seconds da última leitura de tendência
  spicy          Int @default(0) // camada sensorial: 0 livre · 1 ecchi/suggestive · 2 adulto
  follows        Int? // seguidores (MangaDex) — proxy social de hype
  createdAt      DateTime @default(now())

  @@index([type, popularity])
  @@index([classification])
  @@index([startDate])
  @@index([status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passHash     String // scrypt$N$r$p$salt$hash (node:crypto)
  displayName  String?
  avatarColor  String? // cor do avatar monograma
  bio          String?
  settings     String? // JSON { theme, hypeMode, favorites... }
  adultMode    Boolean  @default(false)
  adultConsent String? // ISO date do consentimento +18
  avatarHue    Int? // matiz do banner personalizado do perfil
  bannerHue    Int? // matiz do banner personalizado do perfil
  prefs        String? // JSON preferências extras (labels, privacy...)
  tokenVersion Int      @default(0) // incrementa para invalidar sessões antigas
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
  library      LibraryItem[]
  sessions     Session[]
  shelf        ShelfEntry[]
  lists        UserList[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // sha256 do token do cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  ua        String?

  @@index([userId])
}

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  status    String   @default("plan") // reading | completed | plan | paused | dropped | favorite
  rating    Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([userId, updatedAt])
}

model EventLog {
  id      String   @id @default(cuid())
  userId  String?
  kind    String // auth_register | auth_login | adult_toggle | sync_push | sync_pull | cron_refresh ...
  payload String?
  at      DateTime @default(now())

  @@index([at])
}

// Prateleira pessoal (v2 experimental — mesmo conceito da LibraryItem com progresso)
model ShelfEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  status    String   @default("PLANNING") // READING | PLANNING | COMPLETED | FAVORITE | PAUSED | DROPPED
  rating    Int?
  progress  Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([userId, updatedAt])
}

// Listas customizadas do usuário (coleções nomeadas de obras)
model UserList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  emoji       String   @default("📚")
  description String?
  workIds     String   @default("[]") // JSON string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Estado do pulso de sincronização (linha única id="main")
model SyncState {
  id           String   @id
  lastSync     Int      @default(0) // unix seconds
  worksTouched Int      @default(0)
  note         String?
}

// Metadados da última sincronização por fonte (id="anilist")
model SyncMeta {
  id       String @id
  lastSync Int    @default(0) // unix seconds
  added    Int    @default(0)
  updated  Int    @default(0)
}

// Cache persistente do feed de notícias (linha única id="mal-rss")
model NewsCache {
  id        String @id
  fetchedAt Int    @default(0) // unix seconds
  items     String @default("[]") // JSON NewsItem[]
}

// Feed social ao vivo: reposts de fontes oficiais/comunidade + matérias da redação.
// kind: "official" (fonte oficial/comunidade: Reddit, Kitsu…) | "editorial" (Redação OtakuVerse)
// Idempotente: id = hash estável do conteúdo → re-ingestão nunca duplica, nunca apaga.
model FeedPost {
  id          String   @id
  kind        String // official | editorial
  source      String // "Reddit · r/manga" | "Kitsu" | "Redação OtakuVerse" | "X (Twitter)" …
  handle      String? // @conta ou autor do post original
  title       String?
  body        String
  image       String?
  url         String? // link do post original
  workId      String? // obra relacionada no catálogo
  tags        String? // JSON string[]
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([kind])
}
